# Copie este archivo como .env.local (desarrollo). En Vercel, defina las variables en el panel.
# Nunca suba a git un archivo con valores reales.

# Conexión a PostgreSQL (Neon la crea automáticamente al conectar la integración).
DATABASE_URL=
# Conexión directa (sin pooler), usada para las migraciones. Neon la crea automáticamente.
DATABASE_URL_UNPOOLED=

# Clave de un solo uso para crear las dos primeras cuentas (mínimo 20 caracteres, aleatoria).
# Bórrela del servidor después de crear las cuentas.
CLAVE_CONFIGURACION=

# Opcional: dirección pública de la aplicación, para los enlaces de restablecimiento.
APP_URL=

# Opcional: tamaño máximo de comprobantes en MB (por defecto 8, máximo 10).
COMPROBANTE_MAX_MB=8

# Solo para una instalación de demostración separada (nunca en la real).
MODO_DEMO=
